{
  "exec": "node --require ts-node/register --require tsconfig-paths/register --inspect=0.0.0.0:9229 ./src/bin/nodemon-entry.ts",
  "ext": "ts,html",
  "watch": ["./src", "./src/views"],
  "events": {
    "restart": "echo '🔄 '  Nodemon Restarting...",
    "crash": "echo '💥 '  Nodemon Crashed!"
  }
}